{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Edit(.claude)",
      "Read",
      "Bash(bash /mnt/d/PycharmProjects/Mefan/.mefan/hooks/conversation-log.sh assistant)",
      "Bash(jq:*)",
      "Bash(python3:*)",
      "Bash(bash /mnt/d/PycharmProjects/Mefan/.mefan/hooks/conversation-log.sh \"assistant\" \"placeholder\" \"[user-submit]\" \"prompt-submit\")",
      "Bash(cp /mnt/d/PycharmProjects/Mefan/.mefan/knowledge/global/*.md /mnt/d/PycharmProjects/Mefan/.claude/rules/global/)",
      "Bash(cp /mnt/d/PycharmProjects/Mefan/.mefan/knowledge/scenario-upgrade/*.md /mnt/d/PycharmProjects/Mefan/.claude/rules/scenario-upgrade/)",
      "Bash(cp /mnt/d/PycharmProjects/Mefan/.mefan/knowledge/scenario-refactor/*.md /mnt/d/PycharmProjects/Mefan/.claude/rules/scenario-refactor/)",
      "Bash(ls *.md)",
      "Bash(for f:*)",
      "Bash(do mv:*)",
      "Bash(done)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "UserPromptSubmit",
        "hooks": [
          {
            "type": "command",
            "command": "bash /mnt/d/PycharmProjects/Mefan/.mefan/hooks/conversation-log.sh \"assistant\" \"$(python3 -c \"import sys,json;d=json.load(sys.stdin);print(d.get('text','')[:100])\")\" \"[user-submit]\" \"prompt-submit\"",
            "timeout": 10,
            "statusMessage": "Logging conversation"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "Stop",
        "hooks": [
          {
            "type": "command",
            "command": "bash /mnt/d/PycharmProjects/Mefan/.mefan/hooks/conversation-log.sh \"assistant\" \"[session-end]\" \"[session-end]\" \"session-stop\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
